{
  "title": "Personal keys",
  "rules": [
    {
      "description": "Claude desktop terminal to ctrl + ù or cmd + ù, new terminal to ctrl + shift + ù",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": [
                "left_control"
              ]
            },
            "key_code": "quote"
          },
          "to": [
            {
              "modifiers": [
                "left_command"
              ],
              "key_code": "j"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anthropic\\.claudefordesktop$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": [
                "left_command"
              ]
            },
            "key_code": "quote"
          },
          "to": [
            {
              "modifiers": [
                "left_command"
              ],
              "key_code": "j"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anthropic\\.claudefordesktop$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": [
                "left_control",
                "left_shift"
              ]
            },
            "key_code": "quote"
          },
          "to": [
            {
              "modifiers": [
                "left_control",
                "left_shift"
              ],
              "key_code": "grave_accent_and_tilde"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anthropic\\.claudefordesktop$"
              ]
            }
          ]
        }
      ]
    }
  ]
}