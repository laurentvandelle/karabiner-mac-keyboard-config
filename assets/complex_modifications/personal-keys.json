    {
      "description": "Personal-keys Notion ctrl + Tab toggles between the two last tabs",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": [
                "left_control"
              ]
            },
            "key_code": "tab"
          },
          "to": [
            {
              "modifiers": [
                "left_control"
              ],
              "key_code": "tab"
            },
            {
              "set_variable": {
                "name": "notion_tab_toggle",
                "value": 1
              }
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^notion\\.id$"
              ]
            },
            {
              "type": "variable_if",
              "name": "notion_tab_toggle",
              "value": 0
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": [
                "left_control"
              ]
            },
            "key_code": "tab"
          },
          "to": [
            {
              "modifiers": [
                "left_control",
                "left_shift"
              ],
              "key_code": "tab"
            },
            {
              "set_variable": {
                "name": "notion_tab_toggle",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^notion\\.id$"
              ]
            },
            {
              "type": "variable_if",
              "name": "notion_tab_toggle",
              "value": 1
            }
          ]
        }
      ]
    },
