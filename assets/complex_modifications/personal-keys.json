                "any"
              ]
            },
            "key_code": "grave_accent_and_tilde"
          },
          "to": [
            {
              "key_code": "non_us_backslash"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 13364,
                  "product_id": 1819,
                  "is_keyboard": true
                }
              ]
            }
          ]
        }
      ]
    },
